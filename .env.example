# Production canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=

# Future production contact and form integration. Keep values server-side; never expose secrets in NEXT_PUBLIC_ variables.
CONTACT_EMAIL=
FORM_ENDPOINT=
ANALYTICS_ID=

# Stage 8 only: server-side inquiry delivery and upload configuration.
INQUIRY_EMAIL_TO=
INQUIRY_PROVIDER_API_KEY=
UPLOAD_STORAGE_BUCKET=
UPLOAD_STORAGE_REGION=
UPLOAD_STORAGE_ACCESS_KEY=
UPLOAD_STORAGE_SECRET_KEY=

# Optional. Required only when the explicit OpenAI image-generation API/CLI fallback is selected.
OPENAI_API_KEY=
