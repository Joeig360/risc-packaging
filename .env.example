# Production canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Future production contact. Keep values server-side; never expose secrets in NEXT_PUBLIC_ variables.
CONTACT_EMAIL=

# B2B inquiry delivery. Resend credentials must remain server-side.
# Use a verified Resend sender address for INQUIRY_FROM_EMAIL.
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
RESEND_API_KEY=
# Optional customer confirmation email after the internal inquiry notification succeeds.
INQUIRY_SEND_CONFIRMATION=false

# Cloudflare Turnstile. Configure both together in production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Deprecated aliases, accepted temporarily for a non-breaking migration.
INQUIRY_EMAIL_TO=
INQUIRY_EMAIL_FROM=

# Analytics and search verification stay inactive until explicitly enabled.
# Obtain IDs from the relevant account; do not commit real values.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
